# ─────────────────────────────────────────────────────────────────────
# Robot Emploi CI — secrets. Copier en « .env » et remplir.
# Le fichier .env n'est jamais versionné (voir .gitignore).
# ─────────────────────────────────────────────────────────────────────

# ─── Envoi du rapport par email (SMTP) ───────────────────────────────
# Gmail : créer un « mot de passe d'application » sur
# https://myaccount.google.com/apppasswords (la validation en deux
# étapes doit être active). Le mot de passe habituel ne marche pas.
SMTP_HOTE=smtp.gmail.com
SMTP_PORT=587
SMTP_UTILISATEUR=ton.adresse@gmail.com
SMTP_MOTDEPASSE=xxxx xxxx xxxx xxxx
EMAIL_EXPEDITEUR=ton.adresse@gmail.com
EMAIL_DESTINATAIRES=ton.adresse@gmail.com

# ─── Notifications Telegram (facultatif) ─────────────────────────────
# Jeton : parler à @BotFather, commande /newbot.
# Identifiant de discussion : parler à @userinfobot.
# Laisser vide pour désactiver Telegram.
TELEGRAM_JETON=
TELEGRAM_CHAT_ID=
